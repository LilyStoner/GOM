  <Style TargetType="TextBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
