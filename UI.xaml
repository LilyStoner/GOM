 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="44"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Delivery Copy" FontSize="22" FontWeight="SemiBold" Foreground="#17263C"/>
    <TextBlock Text="Create a delivery package from files or Git changes" Margin="0,3,0,0" Foreground="#5D6B7E"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D7DFE9" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Profile:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#28384D" Margin="0,0,8,0"/>
     <ComboBox x:Name="ProjectProfileCombo" Width="170" Height="30" SelectedIndex="1">
      <ComboBoxItem Content="BVSC"/>
      <ComboBoxItem Content="BSC"/>
     </ComboBox>
    </StackPanel>
   </Border>
   <Border Grid.Column="3" Background="#EAF2FF" CornerRadius="14" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="InlineStatus" Text="Ready" Foreground="#1463D6" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#D7DFE9" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Step1Button" Grid.Column="0" Style="{StaticResource Step}" Content="1  Select files"/><Button x:Name="Step2Button" Grid.Column="1" Style="{StaticResource Step}" Content="2  Review (0)" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/><Button x:Name="Step3Button" Grid.Column="2" Style="{StaticResource Step}" Content="3  Deliver" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/></Grid></Border>
  <Grid Grid.Row="4">
   <ScrollViewer x:Name="CollectScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid x:Name="CollectView" MaxWidth="960" HorizontalAlignment="Center" VerticalAlignment="Top">
 <StackPanel>
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <TextBlock Text="Git branch comparison" FontSize="16" FontWeight="SemiBold" Foreground="#17263C"/>
    <TextBlock Text="Compare two Git branches. App will automatically checkout &amp; pull the compare branch to local to get the latest files." Foreground="#5D6B7E" TextWrapping="Wrap" Margin="0,4,0,14"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Repository folder" Foreground="#28384D"/><TextBox x:Name="RepoPath" TabIndex="30" Margin="0,6,0,0"/></StackPanel><Button x:Name="ChooseRepoButton" TabIndex="31" Grid.Column="2" Content="Select folder" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/></Grid>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Base branch" Foreground="#28384D"/><ComboBox x:Name="BaseBranch" TabIndex="32" IsEditable="True" IsEnabled="False" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Compare branch" Foreground="#28384D"/><ComboBox x:Name="CompareBranch" TabIndex="33" IsEditable="True" IsEnabled="False" Margin="0,6,0,0"/></StackPanel><Button x:Name="LoadBranchesButton" TabIndex="34" Grid.Column="4" Content="Load branches" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/></Grid>
    <StackPanel Orientation="Vertical" Margin="0,14,0,0">
     <CheckBox x:Name="AutoCheckoutAndPull" TabIndex="35" Content="Auto checkout &amp; pull compare branch to local" IsChecked="True" Foreground="#1463D6" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <CheckBox x:Name="IncludeWorkspace" TabIndex="36" Content="Include uncommitted changes" IsChecked="False" VerticalAlignment="Center" Foreground="#28384D"/>
      <Button x:Name="AddGitChangesButton" TabIndex="37" Content="Add Git changes" Style="{StaticResource Primary}" Margin="20,0,0,0" IsEnabled="False"/>
     </StackPanel>
    </StackPanel>
    <TextBlock x:Name="GitHint" Margin="0,10,0,0" Foreground="#5D6B7E" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <ProgressBar x:Name="CollectProgress" Height="5" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
  <TextBlock x:Name="CollectHint" Margin="0,8,0,0" Foreground="#5D6B7E" TextWrapping="Wrap"/>
  <Expander x:Name="AdvancedCollect" Header="More options" Margin="0,20,0,0" Foreground="#1463D6"><StackPanel Margin="0,14,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Exclude rules" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Separate rules with semicolons. Example: bin;obj;*.tmp" Foreground="#5D6B7E" FontSize="12" Margin="0,4,0,8"/><TextBox x:Name="ExcludeRules" TabIndex="20" Text="bin;obj;.git;.vs;node_modules;*.tmp;*.user;*.suo"/></StackPanel></Border><Expander Header="Paste file paths" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="One path per line. Absolute paths or paths relative to the repository are supported." Foreground="#5D6B7E" FontSize="12" TextWrapping="Wrap"/><TextBox x:Name="PasteInput" TabIndex="21" Height="96" Margin="0,8,0,8" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal"><Button x:Name="AddPathsButton" TabIndex="22" Content="Add paths" Style="{StaticResource Secondary}"/><TextBlock x:Name="PasteResult" Margin="12,9,0,0" Foreground="#5D6B7E" TextWrapping="Wrap"/></StackPanel></StackPanel></Expander></StackPanel></Expander>
 </StackPanel>
</Grid></ScrollViewer>
   <Grid x:Name="ReviewView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Review files" FontSize="18" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Only checked files are included in delivery." Foreground="#5D6B7E" FontSize="12"/></StackPanel><TextBlock x:Name="ReviewSummary" Grid.Column="2" VerticalAlignment="Center" Foreground="#28384D" FontWeight="SemiBold"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="38"/><ColumnDefinition Width="4"/><ColumnDefinition Width="38"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TabIndex="40" Height="34" VerticalContentAlignment="Center" ToolTip="Search by file name or path"/><ComboBox x:Name="FilterBox" TabIndex="41" Grid.Column="2" Height="34" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Included"/><ComboBoxItem Content="Not included"/><ComboBoxItem Content="SQL"/><ComboBoxItem Content="Errors"/></ComboBox><Button x:Name="SortAscendingButton" TabIndex="44" Grid.Column="4" Content="&#x2191;" Style="{StaticResource Secondary}" ToolTip="Sort package paths A to Z" MinWidth="38" FontSize="16" FontWeight="SemiBold"/><Button x:Name="SortDescendingButton" TabIndex="45" Grid.Column="6" Content="&#x2193;" Style="{StaticResource Secondary}" ToolTip="Sort package paths Z to A" MinWidth="38" FontSize="16" FontWeight="SemiBold"/><Button x:Name="SortSqlFlexButton" TabIndex="46" Grid.Column="8" Content="Sort SQL (FlexDB Order)" Style="{StaticResource Secondary}" ToolTip="Sort SQL scripts by database execution order (ChangeScripts -> View -> Trigger -> Procedure -> Function -> Package -> Parameters)"/><TextBlock x:Name="ReviewActionHint" Grid.Column="10" VerticalAlignment="Center" Foreground="#5D6B7E" FontSize="12"/><TextBlock x:Name="EmptyState" Text="No files yet. Return to Select files to begin." Foreground="#5D6B7E" Visibility="Collapsed"/></Grid><DataGrid x:Name="FileGrid" Grid.Row="4" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTemplateColumn Width="34"><DataGridTemplateColumn.Header><CheckBox x:Name="ToggleFilteredButton" Width="13" Height="13" FocusVisualStyle="{x:Null}" ToolTip="Include or exclude all filtered files"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="13" Height="13" Focusable="False" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="PACKAGE PATH" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Relative}" ToolTip="{Binding Relative}" Foreground="#0645C0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="EXT" Binding="{Binding FileType}" Width="58" IsReadOnly="True"/><DataGridTemplateColumn Header="CHANGE" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="#0645C0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="72" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SelectAllButton" Content="Include all" Style="{StaticResource Secondary}"/><Button x:Name="ClearSelectionButton" Grid.Column="2" Content="Exclude all" Style="{StaticResource Secondary}"/><Button x:Name="RemoveSelectedButton" Grid.Column="4" Content="Remove included files" Style="{StaticResource Danger}"/><Button x:Name="ContinueButton" Grid.Column="6" Content="Continue (0 files)" Style="{StaticResource Primary}" IsEnabled="False"/></Grid></Grid>
   <ScrollViewer x:Name="DeliverScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid x:Name="DeliverView" Visibility="Collapsed" MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Top"><StackPanel>
 <TextBlock x:Name="DeliverTitle" Text="Deliver" FontSize="18" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock x:Name="DeliverSummary" Margin="0,5,0,16" Foreground="#5D6B7E"/>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Destination folder" FontSize="15" FontWeight="SemiBold" Foreground="#28384D"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationPath" TabIndex="50" Height="38" VerticalContentAlignment="Center"/><Button x:Name="ChooseDestinationButton" TabIndex="51" Grid.Column="2" Content="Select folder" Style="{StaticResource Secondary}"/></Grid><TextBlock x:Name="DestinationInfo" Margin="0,8,0,0" Foreground="#5D6B7E" TextWrapping="Wrap"/><TextBlock x:Name="ConflictInfo" Margin="0,4,0,0" Foreground="#A96500" TextWrapping="Wrap"/><TextBlock x:Name="DestinationError" Margin="0,8,0,0" Foreground="#B42318" Visibility="Collapsed" TextWrapping="Wrap"/><Button x:Name="BackToReviewButton" Content="Back to review" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
 <Border x:Name="DeliveryOptions" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Delivery settings" FontSize="15" FontWeight="SemiBold" Foreground="#28384D"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="When file already exists" VerticalAlignment="Center" Foreground="#28384D"/><ComboBox x:Name="DuplicateMode" TabIndex="52" Grid.Column="1" Height="36" SelectedIndex="0" Background="White" IsEditable="True" IsReadOnly="True"><ComboBoxItem Content="Skip"/><ComboBoxItem Content="Overwrite"/><ComboBoxItem Content="Rename automatically"/></ComboBox></Grid>
 <TextBlock x:Name="ProfileDeliveryHint" Margin="0,12,0,0" Foreground="#1463D6" FontSize="12" TextWrapping="Wrap"/>
 <StackPanel x:Name="SqlOptions" Visibility="Collapsed" Margin="0,16,0,0"><Separator/><CheckBox x:Name="CreateRunScript" TabIndex="54" Content="Generate deployment scripts for SQL files" IsChecked="True" Foreground="#28384D" Margin="0,14,0,0"/><TextBlock x:Name="SqlScriptDescription" Text="Scripts follow the Review order. Use Sort SQL to order ChangeScripts, Views, Triggers, Procs, Packages, Parameters." Foreground="#5D6B7E" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="SqlConfigError" Margin="0,8,0,0" Foreground="#B42318" Visibility="Collapsed" TextWrapping="Wrap"/><StackPanel x:Name="SqlSettingsLine" Visibility="Visible" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="ConfigureSqlButton" TabIndex="55" Content="Configure DB credentials" Style="{StaticResource Secondary}"/><TextBlock x:Name="SqlConfigSummary" Text="DB: HOSTBVSFUND@FLEX_236" Foreground="#5D6B7E" FontSize="12" Margin="12,9,0,0"/></StackPanel></StackPanel><CheckBox x:Name="VerifyHash" TabIndex="53" Content="Verify SHA-256 after copying" IsChecked="True" Foreground="#28384D" Margin="0,16,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource Card}" Background="#EAF2FF" BorderBrush="#A9C7F5" Margin="0,16,0,0"><StackPanel><TextBlock Text="Run delivery" FontSize="15" FontWeight="SemiBold" Foreground="#28384D"/><ProgressBar x:Name="DeliveryProgress" Height="8" Margin="0,14,0,0"/><TextBlock x:Name="DeliveryStatus" Margin="0,10,0,0" Foreground="#28384D" FontWeight="SemiBold" Text="Ready"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="StartDeliveryButton" TabIndex="56" Content="Start delivery" Style="{StaticResource Primary}"/><Button x:Name="CancelDeliveryButton" Content="Cancel" Style="{StaticResource Danger}" Margin="12,0,0,0" IsEnabled="False"/></StackPanel></StackPanel></Border>
 <Border x:Name="ResultPanel" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResultTitle" FontSize="16" FontWeight="SemiBold" Foreground="#16794A"/><TextBlock x:Name="ResultSummary" Margin="0,6,0,12" Foreground="#28384D"/><StackPanel Orientation="Horizontal"><Button x:Name="OpenDestinationButton" Content="Open destination folder" Style="{StaticResource Secondary}"/><Button x:Name="OpenManifestButton" Content="Open manifest" Style="{StaticResource Secondary}" Margin="12,0,0,0"/><Button x:Name="ReviewErrorsButton" Content="Review failed files" Style="{StaticResource Secondary}" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
</StackPanel></Grid></ScrollViewer>
  </Grid>
 </Grid>
</Window>
