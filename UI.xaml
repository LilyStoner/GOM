<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delivery Copy" Width="1180" Height="780" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen"
 Background="#F5F7FA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#1463D6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1463D6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#0F54B6"/><Setter TargetName="border" Property="BorderBrush" Value="#0F54B6"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value=".88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Background" Value="#D7DFE9"/><Setter TargetName="border" Property="BorderBrush" Value="#D7DFE9"/><Setter Property="Foreground" Value="#5D6B7E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#28384D"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#EEF3FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#9AA7B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="CanUserAddRows" Value="False"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="44"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Delivery Copy" FontSize="22" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Create a delivery package from files or Git changes" Margin="0,3,0,0" Foreground="#5D6B7E"/></StackPanel><Border Grid.Column="1" Background="#EAF2FF" CornerRadius="14" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="InlineStatus" Text="Ready" Foreground="#1463D6" TextTrimming="CharacterEllipsis"/></Border></Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#D7DFE9" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Step1Button" Grid.Column="0" Style="{StaticResource Step}" Content="1  Select files"/><Button x:Name="Step2Button" Grid.Column="1" Style="{StaticResource Step}" Content="2  Review (0)" IsEnabled="False" ToolTip="Add at least one file to review." ToolTipService.ShowOnDisabled="True"/><Button x:Name="Step3Button" Grid.Column="2" Style="{StaticResource Step}" Content="3  Deliver" IsEnabled="False" ToolTip="Select at least one file to deliver." ToolTipService.ShowOnDisabled="True"/></Grid></Border>
  <Grid Grid.Row="4">
   <ScrollViewer x:Name="CollectScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid x:Name="CollectView" MaxWidth="880" HorizontalAlignment="Center" VerticalAlignment="Top"><StackPanel><TextBlock Text="Select files for delivery" FontSize="18" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Select files or a folder, then review before delivery." Foreground="#5D6B7E" Margin="0,5,0,24"/><StackPanel Orientation="Horizontal"><Button x:Name="ChooseFilesButton" TabIndex="10" Content="Select files" Style="{StaticResource Primary}" MinWidth="150"/><Button x:Name="ChooseFolderButton" TabIndex="11" Content="Select folder" Style="{StaticResource Secondary}" MinWidth="150" Margin="12,0,0,0"/></StackPanel><ProgressBar x:Name="CollectProgress" Height="5" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="CollectHint" Margin="0,8,0,0" Foreground="#5D6B7E"/><Expander x:Name="AdvancedCollect" Header="Advanced options" Margin="0,28,0,0" Foreground="#1463D6"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Exclude rules" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Separate rules with semicolons. Example: bin;obj;*.tmp" Foreground="#5D6B7E" FontSize="12" Margin="0,4,0,8"/><TextBox x:Name="ExcludeRules" TabIndex="20" Text="bin;obj;.git;.vs;node_modules;*.tmp;*.user;*.suo"/></StackPanel></Border><Expander Header="Paste file paths" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="One path per line. Absolute paths or paths relative to the repository are supported." Foreground="#5D6B7E" FontSize="12"/><TextBox x:Name="PasteInput" TabIndex="21" Height="96" Margin="0,8,0,8" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal"><Button x:Name="AddPathsButton" TabIndex="22" Content="Add paths" Style="{StaticResource Secondary}"/><TextBlock x:Name="PasteResult" Margin="12,9,0,0" Foreground="#5D6B7E"/></StackPanel></StackPanel></Expander><Expander Header="Get files from Git comparison" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Remote branches are refreshed before comparison. The current branch is not changed." Foreground="#5D6B7E" FontSize="12" TextWrapping="Wrap"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Repository folder" Foreground="#28384D"/><TextBox x:Name="RepoPath" TabIndex="30" Margin="0,6,0,0"/></StackPanel><Button x:Name="ChooseRepoButton" TabIndex="31" Grid.Column="2" Content="Select folder" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Base branch" Foreground="#28384D"/><ComboBox x:Name="BaseBranch" TabIndex="32" IsEditable="True" IsEnabled="False" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Compare branch" Foreground="#28384D"/><ComboBox x:Name="CompareBranch" TabIndex="33" IsEditable="True" IsEnabled="False" Margin="0,6,0,0"/></StackPanel><Button x:Name="LoadBranchesButton" TabIndex="34" Grid.Column="4" Content="Load branches" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox x:Name="IncludeWorkspace" TabIndex="35" Content="Include uncommitted changes" IsChecked="True" VerticalAlignment="Center" Foreground="#28384D"/><Button x:Name="AddGitChangesButton" TabIndex="36" Content="Add Git changes" Style="{StaticResource Primary}" Margin="20,0,0,0" IsEnabled="False"/></StackPanel><TextBlock x:Name="GitHint" Margin="0,8,0,0" Foreground="#5D6B7E" FontSize="12"/></StackPanel></Expander></StackPanel></Expander></StackPanel></Grid></ScrollViewer>
   <Grid x:Name="ReviewView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Review files" FontSize="18" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock Text="Only checked files are included in delivery." Foreground="#5D6B7E" FontSize="12"/></StackPanel><TextBlock x:Name="ReviewSummary" Grid.Column="2" VerticalAlignment="Center" Foreground="#28384D" FontWeight="SemiBold"/><TextBox x:Name="SearchBox" TabIndex="40" Grid.Column="3" Height="36" VerticalContentAlignment="Center" ToolTip="Search by file name or path"/><ComboBox x:Name="FilterBox" TabIndex="41" Grid.Column="5" Height="36" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Selected"/><ComboBoxItem Content="Not selected"/><ComboBoxItem Content="SQL"/><ComboBoxItem Content="Errors"/></ComboBox></Grid><TextBlock x:Name="EmptyState" Grid.Row="2" Text="No files yet. Return to Select files to begin." Foreground="#5D6B7E" Visibility="Collapsed"/><DataGrid x:Name="FileGrid" Grid.Row="4" AutoGenerateColumns="False" SelectionMode="Extended"><DataGrid.Columns><DataGridTemplateColumn Width="42"><DataGridTemplateColumn.Header><CheckBox x:Name="ToggleFilteredButton" ToolTip="Select or clear all filtered files"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="FILE NAME" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#28384D" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceFolder}" FontSize="11" Foreground="#5D6B7E" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PACKAGE PATH" Binding="{Binding Relative}" Width="3*" IsReadOnly="True"/><DataGridTextColumn Header="TYPE" Binding="{Binding FileType}" Width="76" IsReadOnly="True"/><DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True"/><DataGridTemplateColumn Header="STATUS" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SelectAllButton" Content="Select all" Style="{StaticResource Secondary}"/><Button x:Name="ClearSelectionButton" Grid.Column="2" Content="Clear selection" Style="{StaticResource Secondary}"/><Button x:Name="RemoveSelectedButton" Grid.Column="4" Content="Remove selected files" Style="{StaticResource Secondary}" Foreground="#B42318"/><Button x:Name="ContinueButton" Grid.Column="6" Content="Continue (0 file)" Style="{StaticResource Primary}" IsEnabled="False"/></Grid></Grid>
   <ScrollViewer x:Name="DeliverScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid x:Name="DeliverView" Visibility="Collapsed" MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="DeliverTitle" Text="Deliver" FontSize="18" FontWeight="SemiBold" Foreground="#17263C"/><TextBlock x:Name="DeliverSummary" Margin="0,5,0,16" Foreground="#5D6B7E"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Destination folder" FontWeight="SemiBold" Foreground="#28384D"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationPath" TabIndex="50" Height="38" VerticalContentAlignment="Center"/><Button x:Name="ChooseDestinationButton" TabIndex="51" Grid.Column="2" Content="Select folder" Style="{StaticResource Secondary}"/></Grid><TextBlock x:Name="DestinationError" Margin="0,8,0,0" Foreground="#B42318" Visibility="Collapsed"/><Button x:Name="BackToReviewButton" Content="Back to review" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border><Border x:Name="DeliveryOptions" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="When file already exists" VerticalAlignment="Center" Foreground="#28384D"/><ComboBox x:Name="DuplicateMode" TabIndex="52" Grid.Column="1" Height="36" SelectedIndex="0"><ComboBoxItem Content="Skip"/><ComboBoxItem Content="Overwrite"/><ComboBoxItem Content="Rename automatically"/></ComboBox></Grid><Expander Header="Advanced options" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><CheckBox x:Name="VerifyHash" TabIndex="53" Content="Verify SHA-256 after copying" IsChecked="True" Foreground="#28384D"/><StackPanel x:Name="SqlOptions" Visibility="Collapsed" Margin="0,12,0,0"><CheckBox x:Name="CreateRunScript" TabIndex="54" Content="Create runscript.sql" Foreground="#28384D"/><TextBlock x:Name="SqlConfigError" Margin="0,8,0,0" Foreground="#B42318" Visibility="Collapsed" TextWrapping="Wrap"/><StackPanel x:Name="SqlSettingsLine" Visibility="Collapsed" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="ConfigureSqlButton" TabIndex="55" Content="Configure SQL*Plus" Style="{StaticResource Secondary}"/><TextBlock Text="The script does not store passwords. SQL*Plus prompts when it runs." Foreground="#5D6B7E" FontSize="12" Margin="12,9,0,0"/></StackPanel></StackPanel></StackPanel></Expander><StackPanel Margin="0,20,0,0"><ProgressBar x:Name="DeliveryProgress" Height="8"/><TextBlock x:Name="DeliveryStatus" Margin="0,8,0,0" Foreground="#5D6B7E" Text="Ready"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="StartDeliveryButton" TabIndex="56" Content="Start delivery" Style="{StaticResource Primary}"/><Button x:Name="CancelDeliveryButton" Content="Cancel" Style="{StaticResource Secondary}" Margin="12,0,0,0" IsEnabled="False"/></StackPanel></StackPanel></StackPanel></Border><Border x:Name="ResultPanel" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResultTitle" FontSize="16" FontWeight="SemiBold" Foreground="#16794A"/><TextBlock x:Name="ResultSummary" Margin="0,6,0,12" Foreground="#28384D"/><StackPanel Orientation="Horizontal"><Button x:Name="OpenDestinationButton" Content="Open destination folder" Style="{StaticResource Secondary}"/><Button x:Name="OpenManifestButton" Content="Open manifest" Style="{StaticResource Secondary}" Margin="12,0,0,0"/><Button x:Name="ReviewErrorsButton" Content="Review failed files" Style="{StaticResource Secondary}" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></Border></StackPanel></Grid></ScrollViewer>
  </Grid>
 </Grid>
</Window>
